{
    "elements": [
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Aktiv"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Zugang",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Einen kostenlosen API-Key gibt es unter https://creativecommons.tankerkoenig.de"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "APIKey",
                    "caption": "Tankerkönig API-Key",
                    "width": "420px"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Standort",
            "expanded": true,
            "items": [
                {
                    "type": "Select",
                    "name": "LocationSource",
                    "caption": "Standortquelle",
                    "onChange": "TANK_UpdateLocationForm($id, $LocationSource);",
                    "options": [
                        {
                            "caption": "Symcon-Standort (Location Control)",
                            "value": 0
                        },
                        {
                            "caption": "Eigener Standort (Karte)",
                            "value": 1
                        },
                        {
                            "caption": "Postleitzahl",
                            "value": 2
                        }
                    ]
                },
                {
                    "type": "Label",
                    "name": "SymconLocationInfo",
                    "caption": "Symcon-Standort"
                },
                {
                    "type": "SelectLocation",
                    "name": "Location",
                    "caption": "Standort"
                },
                {
                    "type": "RowLayout",
                    "name": "PLZRow",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "PLZ",
                            "caption": "Postleitzahl",
                            "validate": "^(\\d{5})?$"
                        },
                        {
                            "type": "Button",
                            "caption": "PLZ prüfen",
                            "onClick": "TANK_LookupPLZ($id, $PLZ);"
                        }
                    ]
                },
                {
                    "type": "NumberSpinner",
                    "name": "Radius",
                    "caption": "Suchradius",
                    "suffix": "km",
                    "minimum": 1,
                    "maximum": 25
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Kraftstoffe",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Alle Sorten kommen mit einer einzigen Abfrage. Per Haken festlegen, welche angezeigt werden."
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "FuelE5",
                            "caption": "Super E5"
                        },
                        {
                            "type": "CheckBox",
                            "name": "FuelE10",
                            "caption": "Super E10"
                        },
                        {
                            "type": "CheckBox",
                            "name": "FuelDiesel",
                            "caption": "Diesel"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "FuelSuperPlus",
                            "caption": "Super Plus"
                        },
                        {
                            "type": "CheckBox",
                            "name": "FuelLPG",
                            "caption": "Autogas (LPG)"
                        },
                        {
                            "type": "CheckBox",
                            "name": "FuelCNG",
                            "caption": "Erdgas (CNG)"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Super Plus, LPG und CNG erscheinen nur, wenn Tankerkönig sie liefert. Die Markttransparenzstelle meldet derzeit E5, E10 und Diesel."
                },
                {
                    "type": "Label",
                    "name": "FuelInfo",
                    "caption": "-"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Abfrage",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "UpdateInterval",
                    "caption": "Aktualisierungsintervall",
                    "suffix": "Minuten",
                    "minimum": 5,
                    "maximum": 1440
                },
                {
                    "type": "Select",
                    "name": "SortBy",
                    "caption": "Sortierung der Liste",
                    "options": [
                        {
                            "caption": "Nach Preis",
                            "value": "price"
                        },
                        {
                            "caption": "Nach Entfernung",
                            "value": "dist"
                        }
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "OnlyOpen",
                    "caption": "Nur geöffnete Tankstellen"
                },
                {
                    "type": "NumberSpinner",
                    "name": "MaxEntries",
                    "caption": "Max. Einträge in Liste/Kachel (0 = alle)",
                    "minimum": 0,
                    "maximum": 100
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Extras",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "EnableNational",
                    "caption": "Bundesdurchschnitt abrufen und vergleichen (alle 6 Stunden)"
                },
                {
                    "type": "CheckBox",
                    "name": "EnableHTMLBox",
                    "caption": "HTML-Variable (WebFront / ältere Visualisierungen – die Kachel braucht sie nicht)"
                },
                {
                    "type": "CheckBox",
                    "name": "EnableDetails",
                    "caption": "Detailvariablen (Adresse, Entfernung, Ø-Preis, Höchstpreis, Anzahl)"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "EnableAlert",
                            "caption": "Preisalarm für gewählten Kraftstoff"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AlertThreshold",
                            "caption": "Schwelle",
                            "digits": 3,
                            "suffix": "€",
                            "minimum": 0,
                            "maximum": 5
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Darstellung der Kachel",
            "items": [
                {
                    "type": "Label",
                    "caption": "Bilder als Medienobjekt (Typ Bild) in Symcon anlegen und hier auswählen. Formate: PNG, JPG, WebP, GIF, SVG."
                },
                {
                    "type": "SelectMedia",
                    "name": "BackgroundMedia",
                    "caption": "Hintergrundbild (max. 3 MB)"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "BackgroundDim",
                            "caption": "Abdunkeln",
                            "suffix": "%",
                            "minimum": 0,
                            "maximum": 90
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "BackgroundBlur",
                            "caption": "Unschärfe",
                            "suffix": "px",
                            "minimum": 0,
                            "maximum": 20
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Markenlogos: Marke so eintragen, wie sie in der Kachel steht (Groß-/Kleinschreibung egal). Ohne Logo erscheint das Kürzel."
                },
                {
                    "type": "Label",
                    "name": "BrandInfo",
                    "caption": "-"
                },
                {
                    "type": "List",
                    "name": "BrandLogos",
                    "caption": "Markenlogos",
                    "rowCount": 6,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Marke",
                            "name": "Brand",
                            "width": "220px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Logo (Medienobjekt, max. 512 KB)",
                            "name": "Media",
                            "width": "auto",
                            "add": 0,
                            "edit": {
                                "type": "SelectMedia"
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Jetzt aktualisieren",
            "onClick": "echo TANK_Update($id) ? 'Preise aktualisiert.' : 'Nicht aktualisiert – Tankerkönig erlaubt eine Anfrage pro Minute. Sonst Status bzw. Debug prüfen.';"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Aktiv"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Instanz ist deaktiviert"
        },
        {
            "code": 201,
            "icon": "inactive",
            "caption": "Bitte Tankerkönig API-Key eintragen"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "API-Key ungültig"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "Kein Standort: Symcon-Standort, Karte oder PLZ festlegen"
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "Tankerkönig-API nicht erreichbar oder fehlerhafte Antwort"
        },
        {
            "code": 205,
            "icon": "error",
            "caption": "Mindestens einen Kraftstoff aktivieren"
        }
    ]
}
